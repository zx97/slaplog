# Ignore everything by default
/*

# === Source files ===
!*.hpp
!*.cpp
!Makefile

# === Hooks and CI ===
!/.githooks/
!/.githooks/**
!/.github/
!/.github/**
!/.gitlab-ci.yml

# === Documentation ===
!*.md
!/doc/
!/doc/*.md
# The synthetic sample log is committed gzipped; the uncompressed copy the
# generator writes is a local artifact.
/doc/sample/access.log

# === License ===
!LICENSE

# === Git ===
!.gitignore

# === Build artifacts (always ignored) ===
*.o
*.d
slaplog
build_number.txt

# === Editor temporaries ===
*~
*.swp
*.tmp
session*.md

# === Release packaging ===
!/Dockerfile
!/.dockerignore
!/packaging/
!/packaging/**

# === Build tooling ===
# tools/gen_embedded.py generates embedded.hpp from doc/slaplog.md + LICENSE.
!/tools/
!/tools/*

# === WebAssembly port ===
# Sources are tracked; cross-built libs and compiler output are not.
!/wasm/
/wasm/prebuilt/
/wasm/web/slaplog.js
/wasm/web/slaplog.wasm
# Sample reports staged for the Pages deployment by wasm/deploy.sh.
/wasm/web/sample/

# === Tests ===
# The deny-all rule above would hide the whole suite; jsdom is a local
# dependency and is not tracked.
!/tests/
/tests/node_modules/

# === Working notes (local only) ===
# HANDOFF.md is this checkout's session handoff — a working note, not project
# documentation.  *.md is whitelisted above, so it needs its own rule; keep this
# block last, otherwise an earlier "!..." would pull the file back in.
/HANDOFF.md

# Release packaging artefacts (packaging/build-local.sh, CI)
/dist/
/pkgroot/
/stage/
