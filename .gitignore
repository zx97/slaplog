# Ignore everything by default
/*

# === Source files ===
!*.hpp
!*.cpp
!Makefile

# === Documentation ===
!*.md
!/doc/
!/doc/*.md

# === License ===
!LICENSE

# === Git ===
!.gitignore

# === Build artifacts (always ignored) ===
*.o
*.d
slaplog
build_number.txt

# === Editor temporaries ===
*~
*.swp
*.tmp
session*.md

# === WebAssembly port ===
# Sources are tracked; cross-built libs and compiler output are not.
!/wasm/
/wasm/prebuilt/
/wasm/web/slaplog.js
/wasm/web/slaplog.wasm
