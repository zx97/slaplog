# Ignore everything by default
/*

# === Source files ===
!*.hpp
!*.cpp
!Makefile

# === Documentation ===
!*.md
!/doc/
!/doc/*.md

# === License ===
!LICENSE

# === Git ===
!.gitignore

# === Build artifacts (always ignored) ===
*.o
*.d
slaplog
build_number.txt

# === Editor temporaries ===
*~
*.swp
*.tmp
session*.md

# === Build tooling ===
# tools/gen_embedded.py generates embedded.hpp from doc/slaplog.md + LICENSE.
!/tools/
!/tools/*

# === WebAssembly port ===
# Sources are tracked; cross-built libs and compiler output are not.
!/wasm/
/wasm/prebuilt/
/wasm/web/slaplog.js
/wasm/web/slaplog.wasm

# === Tests ===
# The deny-all rule above would hide the whole suite; jsdom is a local
# dependency and is not tracked.
!/tests/
/tests/node_modules/

# === Working notes (local only) ===
# HANDOFF.md is this checkout's session handoff — a working note, not project
# documentation.  *.md is whitelisted above, so it needs its own rule; keep this
# block last, otherwise an earlier "!..." would pull the file back in.
/HANDOFF.md
